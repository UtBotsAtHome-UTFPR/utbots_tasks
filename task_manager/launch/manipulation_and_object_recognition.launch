<launch>
    <!-- <include file="$(find realsense2_camera)/launch/rs_aligned_depth.launch"/> -->
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
      <param name="video_device" value="/dev/video0" />
      <param name="image_width" value="1280" />
      <param name="image_height" value="720" />
      <param name="pixel_format" value="yuyv" />
      <param name="color_format" value="yuv422p" />
      <param name="camera_frame_id" value="usb_cam" />
      <param name="io_method" value="mmap"/>
    </node>
    <node pkg="yolov8ros" type="yolov8node.py" name="yolov8node" output="screen"/>
    <node pkg="vision_tools" type="extract_3d_centroid.py" name="extract_3d_centroid" output="screen"/>
    <node pkg="task_manager" type="sm_object_manipulation.py" name="sm_object_manipulation" output="screen"/>
    <!-- Run bridge -->
    <!-- <exec cmd="bridge command" /> -->
</launch>
